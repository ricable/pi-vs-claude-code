{
  "theme": "synthwave",
  "prompts": [
    "../.claude/commands"
  ],
  "mcpServers": {
    "rvf": {
      "command": "npx",
      "args": ["@ruvector/rvf-mcp-server", "--transport", "stdio"],
      "env": {
        "RUVECTOR_BACKEND": "rvf"
      }
    },
    "agentdb": {
      "command": "npx",
      "args": ["agentdb@latest", "mcp", "start"],
      "env": {
        "AGENTDB_PATH": ".rvf/learning"
      }
    }
  }
}